{
  "name": "geoneural-web",
  "private": true,
  "version": "0.1.0",
  "description": "Browser front end for GeoNeural: terrain viewer, rate chart and landscape lab.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "wasm": "RUSTFLAGS=\"--remap-path-prefix=$HOME=~\" wasm-pack build ../native/landscape-wasm --target web --release && node scripts/copy-wasm.mjs",
    "wasm:copy": "node scripts/copy-wasm.mjs",
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretypecheck": "node scripts/copy-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
